{
  "name": "daily-discipline",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "start:ai": "node ./scripts/start-expo-with-ai.js",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "qa": "npm run typecheck && npm run test:core && npm run e2e:validate && npx eslint . --no-cache",
    "qa:device": "npm run qa && npx expo install --check && npx expo config --type public",
    "security:check": "bash scripts/security-check.sh",
    "release:check": "npm run qa:device",
    "release:full-check": "bash scripts/release-checklist.sh",
    "deploy:rules": "npx firebase-tools@latest deploy --only firestore:rules",
    "functions:deploy": "bash scripts/deploy-functions-if-blaze.sh",
    "functions:check": "cd functions && npm run lint",
    "ai:dev": "cd ai && .venv/bin/uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "ai:stats": "cd services/stats-aggregator && go run .",
    "security:dev": "cd services/security-gateway && go run .",
    "dev:secure": "bash scripts/dev-secure-stack.sh",
    "ops:check": "bash scripts/check-backend.sh",
    "ops:deploy:ai": "bash scripts/deploy-ai.sh",
    "eas:preview": "npx eas-cli@latest build --profile preview --platform all",
    "eas:simulator": "npx eas-cli@latest build --profile simulator --platform ios",
    "eas:production": "npx eas-cli@latest build --profile production --platform all",
    "eas:testflight": "npx eas-cli@latest build --profile production --platform ios",
    "test:core": "node scripts/test-core-logic.js",
    "ai:eval": "cd ai && if [ -x .venv/bin/python ]; then .venv/bin/python eval_planner.py; else python3 eval_planner.py; fi",
    "e2e:validate": "node scripts/validate-e2e-flows.js",
    "e2e:maestro": "maestro test e2e/maestro/smoke.yaml",
    "stack:config": "docker compose config",
    "stack:up": "docker compose up --build",
    "stack:down": "docker compose down",
    "stack:logs": "docker compose logs -f ai-backend security-gateway stats-aggregator",
    "functions:install": "cd functions && npm install",
    "functions:deploy:blaze": "CONFIRM_BLAZE=1 bash scripts/deploy-functions-if-blaze.sh",
    "tester:check": "npm run qa && node scripts/check-tester-readiness.js",
    "tester:build": "npx eas-cli@latest build --profile preview --platform all",
    "deploy:tester": "npm run deploy:rules && npm run tester:check && npm run tester:build",
    "hosted:check": "bash scripts/check-hosted-backend.sh",
    "tester:ios": "npx eas-cli@latest build --profile preview --platform ios",
    "tester:android": "npx eas-cli@latest build --profile preview --platform android",
    "testflight:build": "npx eas-cli@latest build --profile production --platform ios",
    "testflight:submit": "npx eas-cli@latest submit --platform ios --latest",
    "deploy:testflight": "npm run deploy:rules && npm run tester:check && npm run testflight:build",
    "hosted:preflight": "node scripts/hosted-preflight.js",
    "widget:ios:prepare": "bash scripts/prepare-ios-widget-extension.sh",
    "e2e:maestro:all": "maestro test e2e/maestro",
    "ai:eval:report": "npm run ai:eval && node -e \"console.log(require('fs').readFileSync('ai/evals/latest-report.json','utf8'))\"",
    "focus:ios:prepare": "bash scripts/prepare-ios-focus-extension.sh",
    "load:gateway": "k6 run load/k6/gateway-load.js",
    "load:gateway:local": "GATEWAY_URL=http://127.0.0.1:8020 ADMIN_DASHBOARD_TOKEN=local-dev-admin k6 run load/k6/gateway-load.js",
    "production:preflight": "npm run tester:check && npm run hosted:preflight && npm run ai:eval && npm run functions:check"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "expo": "~57.0.14",
    "expo-av": "~16.0.8",
    "expo-calendar": "~57.0.2",
    "expo-constants": "~57.0.12",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.3",
    "expo-linking": "~57.0.6",
    "expo-notifications": "~57.0.12",
    "expo-router": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.7",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.2",
    "expo-system-ui": "~57.0.2",
    "expo-updates": "~57.0.15",
    "expo-web-browser": "~57.0.2",
    "firebase": "^12.11.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.1",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.13"
    },
    "postcss": "8.5.10"
  },
  "private": true
}
